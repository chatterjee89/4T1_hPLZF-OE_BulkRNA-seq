// Default resource requests, shared across forks. Individual processes may override.

process {
    cpus   = { 2 * task.attempt }
    memory = { 8.GB * task.attempt }
    time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: 'big_mem' {
        memory = { 32.GB * task.attempt }
    }
    withLabel: 'alignment' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
}
