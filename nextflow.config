// Top-level Nextflow configuration shared by all forks.
//
// conf/local.config (gitignored, machine-specific absolute paths) is NOT
// auto-included here. Newer Nextflow config-DSL parsers (confirmed failing
// on 26.04.6) reject any imperative logic — `if`, `def`, `try/catch` — mixed
// with config statements, so a conditional "include it if it exists" isn't
// possible in this file. Instead, pass it explicitly on the command line —
// the standard Nextflow idiom for machine/environment-specific overrides:
//
//   cp conf/local.config.example conf/local.config   # one-time, fill in paths
//   nextflow run forks/star_featurecounts/main.nf -c conf/local.config -profile micromamba
//
// NOTE: each fork's main.nf is the entry script Nextflow is launched with, so
// `projectDir` resolves to that fork's own directory (e.g.
// forks/star_featurecounts/), not the repo root. Repo-root-relative defaults
// below use `launchDir` instead (the directory `nextflow run` was invoked
// from) — which only works if forks are always run from the repo root, as
// documented throughout this repo's READMEs.

includeConfig 'conf/base.config'

params {
    samplesheet = "${launchDir}/samplesheet/BM9FTP_samplesheet.csv"
    outdir      = "${launchDir}/results"
}

profiles {
    micromamba {
        conda.enabled          = true
        conda.useMicromamba    = true
        conda.cacheDir         = "${launchDir}/.envs_cache"
    }
}

manifest {
    name        = '4T1_hPLZF-OE_BulkRNA-seq'
    description = 'STAR and salmon/kallisto quantification forks for 4T1 hPLZF-OE bulk RNA-seq, validated against Plasmidsaurus counts'
    nextflowVersion = '>=23.10'
}
