// Top-level Nextflow configuration shared by all forks.
// Run a specific fork with e.g.:
//   nextflow run forks/star_featurecounts/main.nf -profile micromamba

includeConfig 'conf/base.config'

// conf/local.config is gitignored (machine-specific absolute paths).
// Copy conf/local.config.example to conf/local.config and fill it in.
def localConfig = file("${projectDir}/conf/local.config")
if (localConfig.exists()) {
    includeConfig 'conf/local.config'
} else {
    System.err.println("WARNING: conf/local.config not found — copy conf/local.config.example and fill in paths for this machine.")
}

params {
    samplesheet = "${projectDir}/samplesheet/BM9FTP_samplesheet.csv"
    outdir      = "${projectDir}/results"
}

profiles {
    micromamba {
        conda.enabled          = true
        conda.useMicromamba    = true
        conda.cacheDir         = "${projectDir}/.envs_cache"
    }
}

manifest {
    name        = '4T1_hPLZF-OE_BulkRNA-seq'
    description = 'STAR and salmon/kallisto quantification forks for 4T1 hPLZF-OE bulk RNA-seq, validated against Plasmidsaurus counts'
    nextflowVersion = '>=23.10'
}
